# Copy to .env (chmod 600). Real environment variables override this file.

# Bot token: Stoat client -> Settings -> My Bots -> create bot -> copy token.
STOAT_BOT_TOKEN=

# REST API base. Official instance by default; for a self-hosted Stoat use
# its API URL (the WebSocket URL is read from the API root automatically).
STOAT_API_URL=https://api.stoat.chat
# STOAT_WS_URL=wss://events.stoat.chat

# Optional: skip the GET /users/@me lookup.
# STOAT_BOT_USER_ID=

# Peer bots allowed to wake this agent by @mention (comma-separated user ids).
# Empty = any bot that @mentions us (collaboration default).
# STOAT_ALLOWED_BOTS=

# In server channels only @mentions of the bot and replies to its messages are
# queued. Entries here make every human message count as well (kind
# "channel"; the worker may still decide not to answer). Bots must always
# @mention. Comma-separated; each entry is one of:
#   <channel id>         one channel
#   server:<server id>   every channel of that server, including new ones
#   *                    every server channel the bot can see
# Find ids with `uv run stoatctl.py routes discover`. Restart the bridge after
# changing it.
# STOAT_LISTEN_CHANNELS=server:01J...
# What the worker does with those un-addressed messages:
#   all   (default) always answer, like an @mention (bursts still merge)
#   judge answer only when the message actually needs the bot
# STOAT_LISTEN_REPLY=all

# Files the worker may attach with `stoatctl send --attach` (generated images /
# videos). Checked by magic bytes, so text files such as .env can never be
# uploaded. Size limit and per-message count come from the server.
# STOAT_ATTACH_TYPES=image,video
# STOAT_AUTUMN_URL=https://cdn.stoatusercontent.com

# Channels to ignore entirely (comma-separated channel ids).
# STOAT_IGNORE_CHANNELS=

# After a long outage, do not backfill messages older than this (seconds).
# STOAT_BACKFILL_MAX_AGE_SECS=259200

# Let every Muse hook run start the bridge when it is not running (so no
# service file is needed). install.sh sets this to 1.
# STOAT_AUTOSTART=1

# Runtime state (inbox, cursors, send state). Default: ./data
# STOAT_DATA_DIR=/var/lib/muse-stoat-bridge

# Outbound proxy / custom CA for REST and WebSocket TLS.
# STOAT_PROXY_URL=http://proxy:3128          # REST only
# STOAT_CA_BUNDLE=/etc/ssl/certs/corp-ca.pem

# Channel -> route (one Muse hook each) mapping and generated per-route hook
# scripts. See README §5. Without a routes file there is one route.
# STOAT_ROUTES_FILE=/path/to/muse-stoat-bridge/routes.json
# STOAT_HOOKS_DIR=/path/to/muse-stoat-bridge/hook/routes

# Hook tuning (read by hook/stoat-watch.sh and stoatctl).
# STOAT_HOOK_WINDOW=25       # seconds each hook run watches the inbox
# STOAT_WARM_IDLE=180        # warm-wait idle timeout
# STOAT_WARM_TOTAL=1800      # warm session cap
